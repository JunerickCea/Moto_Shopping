# Copy to .env for local development. Never commit the real .env.

# Neon (or any Postgres) connection string
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Long random string, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Comma-separated emails that become Admin when they sign in with Google.
ADMIN_EMAILS=

PORT=4444
